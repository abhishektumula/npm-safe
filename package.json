{
  "name": "npm-safe",
  "version": "0.1.0",
  "description": "npms: see package intel (deps, health) before you install — an npm wrapper",
  "type": "module",
  "bin": {
    "npms": "./index.ts",
    "npm-safe": "./index.ts"
  },
  "scripts": {
    "start": "bun ./index.ts",
    "check": "bunx tsc --noEmit",
    "test": "bun test --coverage",
    "build": "bun build ./index.ts --outdir ./dist --target node"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@npmcli/arborist": "^10.0.2",
    "@yarnpkg/core": "^4.9.1",
    "@yarnpkg/fslib": "^3.1.5",
    "@yarnpkg/plugin-nm": "^4.1.1",
    "@yarnpkg/plugin-npm": "^3.7.1",
    "@yarnpkg/plugin-pnp": "^4.2.1"
  }
}
