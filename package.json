{
  "name": "npm-safe",
  "version": "0.1.0",
  "description": "See npm package intel (deps, health) before you install",
  "type": "module",
  "bin": {
    "npm-safe": "./index.ts"
  },
  "scripts": {
    "start": "bun ./index.ts",
    "check": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@npmcli/arborist": "^10.0.2",
    "@yarnpkg/core": "^4.9.1",
    "@yarnpkg/plugin-nm": "^4.1.1",
    "@yarnpkg/plugin-npm": "^3.7.1",
    "@yarnpkg/plugin-pnp": "^4.2.1"
  }
}
