{
  "name": "@hort/nps",
  "version": "2.1.0",
  "description": "nps: see package intel (deps, health) before you install — an npm wrapper",
  "type": "module",
  "bin": {
    "nps": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=20.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/abhishektumula/npm-safe#readme",
  "bugs": {
    "url": "https://github.com/abhishektumula/npm-safe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhishektumula/npm-safe.git"
  },
  "keywords": [
    "npm",
    "installer",
    "cli",
    "dependencies",
    "security",
    "snyk",
    "osv",
    "supply-chain",
    "audit"
  ],
  "scripts": {
    "start": "bun ./index.ts",
    "check": "bunx tsc --noEmit",
    "test": "bun test --coverage",
    "build": "bun build ./index.ts --outdir ./dist --target node --packages external",
    "prepublishOnly": "bun run build && chmod +x dist/index.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@npmcli/arborist": "^9.9.3"
  }
}
