{
  "name": "@hort/nps",
  "version": "0.1.1",
  "description": "nps: see package intel (deps, health) before you install — an npm wrapper",
  "type": "module",
  "bin": {
    "nps": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhishektumula/npm-safe.git"
  },
  "keywords": [
    "npm",
    "installer",
    "cli",
    "dependencies",
    "security",
    "snyk"
  ],
  "scripts": {
    "start": "bun ./index.ts",
    "check": "bunx tsc --noEmit",
    "test": "bun test --coverage",
    "build": "bun build ./index.ts --outdir ./dist --target node",
    "prepublishOnly": "bun run build && chmod +x dist/index.js"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@npmcli/arborist": "^10.0.2",
    "@yarnpkg/core": "^4.9.1",
    "@yarnpkg/fslib": "^3.1.5",
    "@yarnpkg/plugin-nm": "^4.1.1",
    "@yarnpkg/plugin-npm": "^3.7.1",
    "@yarnpkg/plugin-pnp": "^4.2.1"
  }
}
